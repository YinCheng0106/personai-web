# PersonAI backend
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_BASE=ws://localhost:8000

# Optional: override MediaPipe CDN/model locations for offline deployment
NEXT_PUBLIC_MEDIAPIPE_WASM_BASE=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.35/wasm
NEXT_PUBLIC_POSE_MODEL_PATH=https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_lite/float16/1/pose_landmarker_lite.task

# Postgres connection string used by better-auth
DATABASE_URL=postgres://user:password@localhost:5432/personai

# better-auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=personai-api
